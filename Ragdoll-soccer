    local function applyEquippedCosmeticsToCharacter()
        if not ConfigState.OverrideSkins then return end
        local char = LocalPlayer.Character
        if not char then return end
        local drawn = getDrawnModel(char)
        if not drawn then return end

        local snap = RS.selectedSkinSnapshot
        local head = drawn:FindFirstChild("Head", true)
        if head and head:IsA("BasePart") then
            if snap.HeadColor then
                pcall(function() head.Color = snap.HeadColor end)
                for _, limb in ipairs(drawn:GetDescendants()) do
                    if limb:IsA("BasePart") and (limb.Name == "Head" or limb.Name:find("Arm") or limb.Name:find("Hand") or limb.Name == "Torso" or limb.Name == "Chest") then
                        pcall(function() limb.Color = snap.HeadColor end)
                    end
                end
            end
            if snap.FaceDecalTexture then
                local faceDecal = head:FindFirstChild("Face") or head:FindFirstChildOfClass("Decal")
                if not faceDecal then
                    faceDecal = Instance.new("Decal")
                    faceDecal.Name = "Face"
                    faceDecal.Face = Enum.NormalId.Front
                    faceDecal.Parent = head
                end
                faceDecal.Texture = snap.FaceDecalTexture
            end
            if snap.HairTemplate then
                local oldHair = head:FindFirstChild("LockerHair") or drawn:FindFirstChild("LockerHair")
                if oldHair then pcall(function() oldHair:Destroy() end) end
                local newHair = cloneTemplateClean(snap.HairTemplate)
                if newHair then
                    newHair.Name = "LockerHair"
                    attachCosmeticPartToLimb(newHair, head, "HairWeld", CFrame.new(0, 0.2, 0))
                end
            end
            if snap.HatTemplate then
                local oldHat = head:FindFirstChild("LockerHat") or drawn:FindFirstChild("LockerHat")
                if oldHat then pcall(function() oldHat:Destroy() end) end
                local newHat = cloneTemplateClean(snap.HatTemplate)
                if newHat then
                    newHat.Name = "LockerHat"
                    attachCosmeticPartToLimb(newHat, head, "HatWeld", CFrame.new(0, 0.35, 0))
                end
            end
        end

        local leftFoot = drawn:FindFirstChild("LeftFoot", true)
        local rightFoot = drawn:FindFirstChild("RightFoot", true)
        if snap.ShoeLeftTemplate and leftFoot and leftFoot:IsA("BasePart") then
            for _, child in ipairs(leftFoot:GetChildren()) do
                if child.Name == "CoreShoeOverride" or child:IsA("MeshPart") or child:IsA("Model") then
                    pcall(function() child:Destroy() end)
                end
            end
            local sL = cloneTemplateClean(snap.ShoeLeftTemplate)
            if sL then
                sL.Name = "CoreShoeOverride"
                attachCosmeticPartToLimb(sL, leftFoot, "ShoeWeldL", CFrame.new())
            end
        end
        if snap.ShoeRightTemplate and rightFoot and rightFoot:IsA("BasePart") then
            for _, child in ipairs(rightFoot:GetChildren()) do
                if child.Name == "CoreShoeOverride" or child:IsA("MeshPart") or child:IsA("Model") then
                    pcall(function() child:Destroy() end)
                end
            end
            local sR = cloneTemplateClean(snap.ShoeRightTemplate)
            if sR then
                sR.Name = "CoreShoeOverride"
                attachCosmeticPartToLimb(sR, rightFoot, "ShoeWeldR", CFrame.new())
            end
        end
    end

