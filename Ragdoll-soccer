                end
            end
            if not action and actionHint then
                local hintLower = actionHint:lower()
                for _, desc in ipairs(scripts:GetDescendants()) do
                    if desc:IsA("InputAction") then
                        local n = desc.Name:lower()
                        local pn = (desc.Parent and desc.Parent.Name:lower()) or ""
                        if n == hintLower or n:find(hintLower, 1, true) or pn:find(hintLower, 1, true) then
