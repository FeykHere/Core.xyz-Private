function MystrixHub.Functions.StartBallTracker()
    local F = MystrixHub.Functions
    F.StopBallTracker()
    if not F.SilentAimModules() or not F.TrackerModules() then return false end
    local T = getgenv().MystrixTracker
    local SA = getgenv().MystrixSilentAim
    local BV = SA.BallView
    local COUNT = 56
    local base = Instance.new("Part")
    base.Name = "MystrixTracker"
    base.Anchored = true
    base.CanCollide = false
    base.CanQuery = false
    base.CanTouch = false
    base.CastShadow = false
    base.Transparency = 1
    base.Size = Vector3.new(0.1, 0.1, 0.1)
    base.CFrame = CFrame.identity
    base.Parent = workspace
    T.Base = base

    local function adorn(className)
        local a = Instance.new(className)
        a.Adornee = base
        a.AlwaysOnTop = true
        a.Color3 = T.Color
        a.Visible = false
        pcall(function() a.AdornCullingMode = Enum.AdornCullingMode.Never end)
        a.Parent = base
        return a
    end

    local segs = {}
    for i = 1, COUNT do
        local s = adorn("LineHandleAdornment")
        s.ZIndex = 2
        s.Thickness = 4
        s.Transparency = 0.05
        segs[i] = s
    end
    local marker = adorn("CylinderHandleAdornment")
    marker.ZIndex = 2
    marker.Height = 0.08
    marker.Radius = 1.1
    marker.InnerRadius = 0
    marker.Transparency = 0.15
    local ring = adorn("CylinderHandleAdornment")
    ring.ZIndex = 1
    ring.Height = 0.06
    ring.Radius = 2.2
    ring.InnerRadius = 1.6
    ring.Transparency = 0.35

    local flat = CFrame.Angles(math.pi / 2, 0, 0)
    local applied = T.Color
    local lastSolve = 0
    local path, hidden, baseMoved = nil, true, false
    local shownFrom = 1

    local function hideAll()
        path = nil
        if hidden then return end
        hidden = true
        for i = 1, COUNT do
            segs[i].Visible = false
        end
        marker.Visible = false
        ring.Visible = false
    end

    local function draw(p)
        local pts = p.pts
        if not pts or #pts < 2 then
            hideAll()
            return
        end
        local n = math.min(#pts - 1, COUNT)
        p.n = n
        for i = 1, n do
            local a, b = pts[i].p, pts[i + 1].p
            local s = segs[i]
            local len = (b - a).Magnitude
            if len > 0.02 then
                s.Length = len
                s.CFrame = CFrame.lookAt(a, b)
                s.Visible = true
            else
                s.Visible = false
            end
        end
        for i = n + 1, COUNT do
            segs[i].Visible = false
        end
        shownFrom = 1
        if p.landing then
            local cf = CFrame.new(p.landing) * flat
            marker.CFrame = cf
            ring.CFrame = cf
            marker.Visible = true
            ring.Visible = true
        else
            marker.Visible = false
            ring.Visible = false
        end
        hidden = false
    end

    -- Clips all past segments behind the ball and anchors the active leading segment at livePos (100% future-only!)
    local function trimFuture(p, nowT, livePos, liveVel)
        local pts = p.pts
        if not pts or not p.n or p.n < 1 then
            hideAll()
            return
        end
        local first = 1
        local flatVel = liveVel and Vector3.new(liveVel.X, 0, liveVel.Z) or Vector3.zero
        local hasDir = flatVel.Magnitude > 1.5
        local velDir = hasDir and flatVel.Unit or Vector3.zero

        while first <= p.n do
            local nextPt = pts[first + 1]
            local pastByTime = (nowT ~= nil and nextPt.t ~= nil and nextPt.t <= nowT)
            local pastBySpace = false
            if livePos and hasDir then
                local toNext = Vector3.new(nextPt.p.X - livePos.X, 0, nextPt.p.Z - livePos.Z)
                if toNext:Dot(velDir) <= 0.08 then
                    pastBySpace = true
                end
            end
            if pastByTime or pastBySpace then
                first += 1
            else
                break
            end
        end

        if first > p.n then
            hideAll()
            return
        end

        for i = 1, first - 1 do
            segs[i].Visible = false
        end

        -- Anchor first visible segment directly at livePos so zero line ever trails behind the ball
        if livePos then
            local nextP = pts[first + 1].p
            local len = (nextP - livePos).Magnitude
            if len > 0.04 then
                segs[first].Length = len
                segs[first].CFrame = CFrame.lookAt(livePos, nextP)
                segs[first].Visible = true
            else
                segs[first].Visible = false
            end
        else
            segs[first].Visible = true
        end

        for i = first + 1, p.n do
            segs[i].Visible = true
        end
        shownFrom = first
    end

    RunService:BindToRenderStep("MystrixBallTracker", Enum.RenderPriority.Camera.Value + 40, function()
        if not T.Enabled then
            hideAll()
            return
        end
        if T.Color ~= applied then
            applied = T.Color
            for i = 1, COUNT do
                segs[i].Color3 = applied
            end
            marker.Color3 = applied
            ring.Color3 = applied
        end
        local ball = BV.getBall()
        local pos = BV.getPosition()
        if not (ball and pos) then
            hideAll()
            return
        end
        local now = os.clock()
        local state, _, ev, cp = BV.freeSim()
        if state and ev and cp and state.vel.Magnitude > 2.5 then
            local key = tostring(ev.seq) .. ":" .. tostring(ev.t)
            if not path or path.mode ~= "free" or path.key ~= key or now - path.at > 1 then
                local ok, pts, landing = pcall(F.TrackerTrace, cp)
                if ok and pts and #pts >= 2 then
                    path = { mode = "free", key = key, at = now, pts = pts, landing = landing }
                    draw(path)
                end
            end
            if path and path.mode == "free" then
                if baseMoved then
                    base.CFrame = CFrame.identity
                    baseMoved = false
                end
                trimFuture(path, state.t, pos, state.vel)
            else
                hideAll()
            end
            return
        end

        -- Dribbling / Aiming / Rolling Future Shot Prediction Mode
        if path and path.mode ~= "solve" then
            hideAll()
        end
        if now - lastSolve >= math.max(T.Rate or 0.25, 0.15) or not path then
            lastSolve = now
            local ok, result = pcall(F.ShotBest, pos, "Laced", false, F.Budget(0.004), nil, "warm")
            local solveVel = (ok and result and result.vel) or nil
            local solveSpin = (ok and result and result.spin) or Vector3.zero
            if not solveVel then
                local rawVel = ball.AssemblyLinearVelocity
                if rawVel and rawVel.Magnitude > 3.5 then
                    solveVel = rawVel
                end
            end
            if solveVel and (not path or (path.vel - solveVel).Magnitude > 0.5 or (path.from - pos).Magnitude > 6) then
                local evt = {
                    seq = 0,
                    t = 0,
                    pos = pos,
                    vel = solveVel,
                    spin = solveSpin,
                    kind = "kick",
                    by = 0,
                    pid = 0,
                    n = 0
                }
                local ok2, pts, landing = pcall(F.TrackerTrace, evt)
                if ok2 and pts and #pts >= 2 then
                    path = { mode = "solve", pts = pts, landing = landing, from = pos, vel = solveVel }
                    draw(path)
                end
            end
        end
        if path and path.mode == "solve" then
            if (pos - path.from).Magnitude > 40 then
                hideAll()
            else
                base.CFrame = CFrame.new(pos - path.from)
                baseMoved = true
            end
        else
            hideAll()
        end
    end)
    MystrixHub.ConnectionController.Insert({ Disconnect = function()
        MystrixHub.Functions.StopBallTracker()
    end })
    return true
end

