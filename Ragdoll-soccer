function MystrixHub.Functions.InstallMaxPower()
    local MP = getgenv().MystrixMaxPower
    if MP.Hooked then return true end
    local ok, Rules = pcall(function()
        return require(Services.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Game"):WaitForChild("Kick")).Rules
    end)
    if not ok or type(Rules) ~= "table" or type(Rules.charge) ~= "function" then return false end
    MP.Hooked = MystrixHub.Functions.HookFunction(Rules, "charge", function(callOrig)
        return function(value)
            local state = getgenv().MystrixMaxPower
            local pc = getgenv().MystrixPowerCurve
            if (state and state.Enabled) or (pc and pc.InstantCharge) then
                return 1
            end
            local base = callOrig(value)
            if pc and pc.PowerMultEnabled and type(base) == "number" then
                local pMult = math.clamp(tonumber(pc.PowerMult) or 1.35, 1.0, 2.5)
                local t = math.clamp((pMult - 1.0) / 1.5, 0, 1)
                return math.clamp(math.max(base * pMult, 0.55 + 0.45 * t), 0, 1)
            end
            return base
        end
    end)
    return MP.Hooked == true
end

