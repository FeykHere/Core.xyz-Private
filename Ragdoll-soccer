function MystrixHub.Functions.PlanSyncCopy(plan)
    local state = getgenv().MystrixSilentAim
    local pc = getgenv().MystrixPowerCurve
    local saOn = state.Enabled and state.PlanSync ~= false
    local pcOn = pc and (pc.PowerMultEnabled or pc.CurveMultEnabled)
    if not (saOn or pcOn) then return nil end
    if type(plan) ~= "table"
        or plan.hold == true
        or typeof(plan.ball) ~= "Vector3"
        or type(plan.family) ~= "string"
        or plan.power == nil
        or plan.leg == nil
        or typeof(plan.dir) ~= "Vector3" then
        return nil
    end
    if saOn then
        local ok, vel, spin = pcall(MystrixHub.Functions.SilentAimPlan, plan)
        if ok and vel then
            vel, spin = MystrixHub.Functions.ApplyPowerCurveVel(vel, spin, plan.family, true)
            local copy = table.clone(plan)
            if (pc and (pc.PowerMultEnabled or pc.InstantCharge)) or (getgenv().MystrixMaxPower and getgenv().MystrixMaxPower.Enabled) then
                copy.power = 1
            end
            local m = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
            if m > 0.001 then
                copy.dir = Vector3.new(vel.X / m, 0, vel.Z / m)
            end
            if typeof(plan.vel) == "Vector3" then
                copy.vel = vel
            end
            if typeof(plan.spin) == "Vector3" and spin then
                copy.spin = spin
            end
            return copy
        end
    end
    if pcOn then
        local copy = table.clone(plan)
        if pc.PowerMultEnabled and type(copy.power) == "number" then
            local pMult = math.clamp(tonumber(pc.PowerMult) or 1.35, 1.0, 2.5)
            copy.power = math.clamp(math.max(copy.power * pMult, 0.85), 0, 1)
        end
        if typeof(copy.vel) == "Vector3" or typeof(copy.spin) == "Vector3" then
            copy.vel, copy.spin = MystrixHub.Functions.ApplyPowerCurveVel(copy.vel, copy.spin, plan.family, false)
        end
        return copy
    end
    return nil
end

