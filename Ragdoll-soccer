                            break
                        end
                    end
                end
            end
        end
        if not action then return false end
        local binding = entry and entry.Binding
        if not (binding and binding.Parent == action) then
            if binding then pcall(function() binding:Destroy() end) end
            binding = Instance.new("InputBinding")
            binding.Name = "CoreXYZ_" .. action.Name
            binding.Type = Enum.InputBindingType.Scriptable
            binding.Parent = action
            RS.scriptableBindings[key] = { Action = action, Binding = binding }
