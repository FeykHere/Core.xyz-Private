    State.stepRagdollSoccer = function(dt)
        local now = os.clock()
        if (now - RS.lastStepClock) < 0.008 then return end
        RS.lastStepClock = now

        local myChar, myRoot, ctrlMgr = getLocalCharAndRoot()
        local ball = getLiveBall()



        if myChar and myRoot then
            local myDribbleId = tonumber(myChar:GetAttribute("DribbleId")) or -999
            local myTeam = myChar:GetAttribute("Team")
            local possessor = (ball and tonumber(ball:GetAttribute("Possessor"))) or 0

            -- 1. Jump Power Override
            if ConfigState.JumpPower then
                local jp = math.clamp(tonumber(ConfigState.JumpPowerVal) or 85, 40, 160)
                if ctrlMgr then
                    pcall(function()
                        local airCtrl = ctrlMgr:FindFirstChildOfClass("AirController")
                        if airCtrl then
                            airCtrl.JumpImpulse = Vector3.new(0, jp * 7.5, 0)
                        end
                    end)
                end
                local hum = myChar:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.UseJumpPower = true
                    hum.JumpPower = jp
                end
            end

            -- 2. Tackle Speed Multiplier (Native MannequinAnimation.Tuning.Slide + Velocity Boost)
            if ConfigState.TackleSpeedMult then
                local mult = math.clamp(tonumber(ConfigState.TackleSpeedVal) or 2.0, 1.0, 5.0)
                pcall(function()
                    if not RS.tuningSlideRef then
                        local T = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Game"):WaitForChild("MannequinAnimation"):WaitForChild("Tuning"))
                        if type(T) == "table" and type(T.Slide) == "table" then
                            RS.tuningSlideRef = T.Slide
                            RS.origSlideSpeed = {}
                            for k, v in pairs(T.Slide) do
                                if type(v) == "number" and (tostring(k):lower():find("speed") or tostring(k):lower():find("vel") or tostring(k):lower():find("dist") or tostring(k):lower():find("impulse")) then
                                    RS.origSlideSpeed[k] = v
                                end
                            end
                        end
                    end
                    if RS.tuningSlideRef and RS.origSlideSpeed then
                        for k, origV in pairs(RS.origSlideSpeed) do
                            RS.tuningSlideRef[k] = origV * mult
                        end
                    end
                end)
                local bodyState = tostring(myChar:GetAttribute("BodyState") or "")
                local slideCd = tonumber(LocalPlayer:GetAttribute("SlideCooldown")) or 0
                local slideReady = tonumber(LocalPlayer:GetAttribute("SlideReadyAt")) or 0
                if bodyState == "Sliding" or bodyState == "Slide" or slideCd > 0 or slideReady > workspace:GetServerTimeNow() then
                    pcall(function()
                        local curVel = myRoot.AssemblyLinearVelocity
                        local horiz = Vector3.new(curVel.X, 0, curVel.Z)
                        if horiz.Magnitude > 2 and horiz.Magnitude < (42 * mult) then
                            local targetSpd = math.min(40 * mult, 150)
                            local boosted = horiz.Unit * targetSpd
                            myRoot.AssemblyLinearVelocity = Vector3.new(boosted.X, curVel.Y, boosted.Z)
                        end
                    end)
                end
            elseif RS.tuningSlideRef and RS.origSlideSpeed then
                pcall(function()
                    for k, origV in pairs(RS.origSlideSpeed) do
                        RS.tuningSlideRef[k] = origV
                    end
                end)
            end

            if ball and ball:IsA("BasePart") then
                local distToBall = (ball.Position - myRoot.Position).Magnitude
                local hasPossession = (possessor == myDribbleId)

                -- 3. Working Ball Magnet (Loose Ball Pull + Pickup Claim)
                if ConfigState.BallMagnet and not hasPossession and (possessor == 0 or possessor == nil) then
                    local magRadius = math.clamp(tonumber(ConfigState.BallMagnetRadius) or 10.0, 3.0, 25.0)
                    if distToBall <= magRadius and distToBall >= 0.4 then
                        local releasedBy = ball:GetAttribute("ReleasedBy")
                        local releasedAt = tonumber(ball:GetAttribute("ReleasedAt")) or 0
                        local recentlyKickedByMe = (releasedBy == myDribbleId) and ((workspace:GetServerTimeNow() - releasedAt) < 0.65)
                        if not recentlyKickedByMe and os.clock() >= (MystrixHub.ShotNext or 0) then
                            pcall(function()
                                local look = myRoot.CFrame.LookVector
                                local flatLook = Vector3.new(look.X, 0, look.Z)
                                if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, -1) end
                                local targetSpot = myRoot.Position + flatLook * 1.65 - Vector3.new(0, 1.45, 0)
                                local toFoot = targetSpot - ball.Position
                                local pullDist = toFoot.Magnitude
                                if pullDist > 0.25 then
                                    local pullSpeed = math.clamp(pullDist * 18, 22, 95)
                                    ball.AssemblyLinearVelocity = toFoot.Unit * pullSpeed
                                    if pullDist <= math.min(magRadius * 0.65, 9.0) then
                                        ball.CFrame = ball.CFrame:Lerp(CFrame.new(targetSpot), 0.38)
                                    end
                                end
                            end)
                        end
                    end
                end

                -- 4. Upgraded Smart Auto-Tackle (Opponent Carrier Check + Predictive Intercept + Scriptable Slide Binding)
                if ConfigState.AutoTackle and not hasPossession and possessor ~= 0 and possessor ~= myDribbleId then
                    local tRange = math.clamp(tonumber(ConfigState.AutoTackleRange) or 18, 5, 40)
                    local bodyState = myChar:GetAttribute("BodyState")
                    if (bodyState == nil or bodyState == "Animated") and (now - RS.lastTackleAt) >= 0.42 then
                        local enemyCarrier = nil
                        local enemyRoot = nil
                        for _, model in ipairs(CollectionService:GetTagged("MannequinCharacter")) do
                            if model ~= myChar and model:IsA("Model") and tonumber(model:GetAttribute("DribbleId")) == possessor then
                                local tTeam = model:GetAttribute("Team")
                                if myTeam == nil or tTeam == nil or tTeam ~= myTeam then
                                    enemyCarrier = model
                                    enemyRoot = model:FindFirstChild("Root") or model:FindFirstChild("HumanoidRootPart")
                                end
                                break
                            end
                        end

                        if enemyCarrier and enemyRoot then
                            local carrierVel = enemyRoot.AssemblyLinearVelocity or Vector3.zero
                            local interceptPos = (ball.Position * 0.55 + enemyRoot.Position * 0.45) + Vector3.new(carrierVel.X, 0, carrierVel.Z) * 0.14
                            local toTarget = Vector3.new(interceptPos.X - myRoot.Position.X, 0, interceptPos.Z - myRoot.Position.Z)
                            local flatDist = toTarget.Magnitude
                            if flatDist <= tRange and flatDist >= 0.8 then
                                RS.lastTackleAt = now
                                pcall(function()
                                    local dir = toTarget.Unit
                                    if ctrlMgr then
                                        ctrlMgr.FacingDirection = dir
                                        ctrlMgr.MovingDirection = dir
                                    end
                                    local mult = ConfigState.TackleSpeedMult and math.clamp(tonumber(ConfigState.TackleSpeedVal) or 2.0, 1.0, 5.0) or 1.25
                                    myRoot.AssemblyLinearVelocity = Vector3.new(dir.X * math.min(44 * mult, 145), myRoot.AssemblyLinearVelocity.Y, dir.Z * math.min(44 * mult, 145))
                                    fireScriptableAction("Slide", "Slide", 0.09)
                                    fireScriptableAction("Mannequin", "Slide", 0.09)
                                    local rSlide = getRemote("RE/MannequinSlide")
                                    if rSlide then
                                        rSlide:FireServer(dir, workspace:GetServerTimeNow())
                                    end
                                end)
                            end
                        end
                    end
                end

                -- 5. Fixed Auto-Call Pass (Scriptable InputBinding + Teammate / Play Check + PassRequest Remote)
                if ConfigState.AutoCallPass and not hasPossession and (now - RS.lastPassCallAt) >= 1.15 then
                    local shouldCall = true
                    if possessor ~= 0 and myTeam then
                        -- Check if an opponent or teammate has the ball; call whenever teammate has it or ball is loose/friendly
                        for _, model in ipairs(CollectionService:GetTagged("MannequinCharacter")) do
                            if model ~= myChar and model:IsA("Model") and tonumber(model:GetAttribute("DribbleId")) == possessor then
                                local tTeam = model:GetAttribute("Team")
                                if tTeam and tTeam ~= myTeam then
                                    shouldCall = false
                                end
                                break
                            end
                        end
                    end
                    if shouldCall then
                        RS.lastPassCallAt = now
                        pcall(function()
                            fireScriptableAction("PassRequest", "CallForPass", 0.08)
                            fireScriptableAction("CallForPass", "CallForPass", 0.08)
                            fireScriptableAction("Pass", "PassRequest", 0.08)
                            for _, rName in ipairs({ "RE/PassRequest", "RE/CallForPass", "RE/CallPass" }) do
                                local rPass = getRemote(rName)
                                if rPass then
                                    pcall(function() rPass:FireServer() end)
                                end
                            end
                        end)
                    end
                end
            end
        end

        -- Periodic Locker Unlock, Override Skins, AFK & Player Data Sync
        if (now - RS.lastMiscSyncAt) >= 0.6 then
            RS.lastMiscSyncAt = now
            if ConfigState.UnlockAll or ConfigState.OverrideSkins then
                syncUnlockAllLocker()
            end
            if ConfigState.OverrideSkins then
                applyEquippedCosmeticsToCharacter()
            end
            if ConfigState.ToggleAFK and (now - (RS.lastAfkFireAt or 0)) >= 4.0 then
                RS.lastAfkFireAt = now
                pcall(function()
                    local rAfk = getRemote("RE/Afk")
                    if rAfk then
                        rAfk:FireServer("inactive")
                    end
                end)
            end
            if ConfigState.DataOverallToggle or ConfigState.DataGoalsToggle or ConfigState.DataAssistsToggle or ConfigState.DataMatchesToggle or ConfigState.DataPotmToggle or ConfigState.DataTimeToggle or ConfigState.DataCardColorToggle then
                syncPlayerDataOverrides()
            end
        end
    end

    local GOAL_CORNER_OFFSETS = {
        Vector3.new(0, 0, 0), Vector3.new(1, 0, 0), Vector3.new(1, 0, 1), Vector3.new(0, 0, 1),
        Vector3.new(0, 1, 0), Vector3.new(1, 1, 0), Vector3.new(1, 1, 1), Vector3.new(0, 1, 1),
    }
    local GOAL_EDGE_PAIRS = {
        { 1, 2 }, { 2, 3 }, { 3, 4 }, { 4, 1 },
        { 5, 6 }, { 6, 7 }, { 7, 8 }, { 8, 5 },
        { 1, 5 }, { 2, 6 }, { 3, 7 }, { 4, 8 },
    }

    local function drawLineFrame(lineFrame, p1, p2, col, thickness)
        local dx = p2.X - p1.X
        local dy = p2.Y - p1.Y
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 1 or dist > 5000 then
            lineFrame.Visible = false
            return
        end
        lineFrame.Position = UDim2.fromOffset((p1.X + p2.X) * 0.5, (p1.Y + p2.Y) * 0.5)
        lineFrame.Size = UDim2.fromOffset(dist, thickness or 1.6)
        lineFrame.Rotation = math.deg(math.atan2(dy, dx))
        lineFrame.BackgroundColor3 = col
        lineFrame.Visible = true
    end

    local function renderGoalBox(camera, lo, hi, linePool, col, enabled)
        if not enabled then
            for i = 1, #linePool do linePool[i].Visible = false end
            return
        end
        local size = hi - lo
        local screenPts = {}
        local onScreenFlags = {}
        for i, off in ipairs(GOAL_CORNER_OFFSETS) do
            local worldPt = lo + Vector3.new(size.X * off.X, size.Y * off.Y, size.Z * off.Z)
            local sp, onScr = camera:WorldToViewportPoint(worldPt)
            screenPts[i] = sp
            onScreenFlags[i] = (onScr and sp.Z > 0)
        end
        for idx, pair in ipairs(GOAL_EDGE_PAIRS) do
            local lineFrame = linePool[idx]
            local a = screenPts[pair[1]]
            local b = screenPts[pair[2]]
            if lineFrame and onScreenFlags[pair[1]] and onScreenFlags[pair[2]] then
                drawLineFrame(lineFrame, Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y), col, 1.8)
            elseif lineFrame then
                lineFrame.Visible = false
            end
        end
    end

    State.renderRagdollSoccer = function(camera, dt)
        local now = os.clock()
        if (now - RS.lastRenderClock) < 0.004 then return end
        RS.lastRenderClock = now

        camera = camera or workspace.CurrentCamera
        if not camera then return end

        local ball = getLiveBall()
        local myChar, myRoot = getLocalCharAndRoot()

        -- 1. Ball ESP + Custom 3D Ball Trail + Neon Ball Glow
        if ball and ball:IsA("BasePart") then
            if ConfigState.BallEsp then
                if not RS.ballHighlight or not RS.ballHighlight.Parent then
                    local hl = Instance.new("Highlight")
                    hl.Name = "CoreXYZ_BallHL"
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillTransparency = 0.35
                    hl.OutlineTransparency = 0.0
                    hl.Parent = UI.HighlightContainer or UI.ScreenGui
                    RS.ballHighlight = hl
                end
                RS.ballHighlight.Adornee = ball
                RS.ballHighlight.FillColor = ConfigState.BallEspColor
                RS.ballHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                RS.ballHighlight.Enabled = true

                if not RS.ballBillboard or not RS.ballBillboard.Parent then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "CoreXYZ_BallTag"
                    bb.Size = UDim2.fromOffset(140, 32)
                    bb.StudsOffset = Vector3.new(0, 2.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = UI.ScreenGui

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.fromScale(1, 1)
                    lbl.BackgroundTransparency = 1
                    lbl.Font = Enum.Font.Code
                    lbl.TextSize = 12
                    lbl.TextStrokeTransparency = 0.15
                    lbl.TextColor3 = ConfigState.BallEspColor
                    lbl.Parent = bb

                    RS.ballBillboard = bb
                    RS.ballTitleLabel = lbl
                end
                local dist = myRoot and math.floor((ball.Position - myRoot.Position).Magnitude) or 0
                local spd = math.floor(ball.AssemblyLinearVelocity.Magnitude)
                RS.ballBillboard.Adornee = ball
                RS.ballBillboard.Enabled = true
                RS.ballTitleLabel.TextColor3 = ConfigState.BallEspColor
                RS.ballTitleLabel.Text = string.format("BALL [%dst | %d s/s]", dist, spd)
            else
                if RS.ballHighlight then RS.ballHighlight.Enabled = false end
                if RS.ballBillboard then RS.ballBillboard.Enabled = false end
            end

            -- Custom 3D Ball Trail
            if ConfigState.CustomBallTrail then
                local halfW = math.clamp((tonumber(ConfigState.BallTrailWidth) or 1.6) * 0.5, 0.2, 2.5)
                if not (RS.ballTrailAtt0 and RS.ballTrailAtt0.Parent == ball) then
                    if RS.ballTrailAtt0 then pcall(function() RS.ballTrailAtt0:Destroy() end) end
                    local a0 = Instance.new("Attachment")
                    a0.Name = "CoreXYZ_TrailAtt0"
                    a0.Parent = ball
                    RS.ballTrailAtt0 = a0
                end
                if not (RS.ballTrailAtt1 and RS.ballTrailAtt1.Parent == ball) then
                    if RS.ballTrailAtt1 then pcall(function() RS.ballTrailAtt1:Destroy() end) end
                    local a1 = Instance.new("Attachment")
                    a1.Name = "CoreXYZ_TrailAtt1"
                    a1.Parent = ball
                    RS.ballTrailAtt1 = a1
                end
                RS.ballTrailAtt0.Position = Vector3.new(0, halfW, 0)
                RS.ballTrailAtt1.Position = Vector3.new(0, -halfW, 0)

                if not (RS.ballTrail and RS.ballTrail.Parent == ball) then
                    if RS.ballTrail then pcall(function() RS.ballTrail:Destroy() end) end
                    local tr = Instance.new("Trail")
                    tr.Name = "CoreXYZ_CustomBallTrail"
                    tr.FaceCamera = true
                    tr.LightEmission = 0.85
                    tr.LightInfluence = 0.15
                    tr.MinLength = 0.05
                    tr.WidthScale = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(0.65, 0.65),
                        NumberSequenceKeypoint.new(1, 0.05),
                    })
                    tr.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.06),
                        NumberSequenceKeypoint.new(0.6, 0.32),
                        NumberSequenceKeypoint.new(1, 1.0),
                    })
                    tr.Parent = ball
                    RS.ballTrail = tr
                end

                local tr = RS.ballTrail
                tr.Attachment0 = RS.ballTrailAtt0
                tr.Attachment1 = RS.ballTrailAtt1
                tr.Lifetime = math.clamp(tonumber(ConfigState.BallTrailLifetime) or 0.65, 0.15, 2.5)
                tr.Enabled = true

                local baseCol = ConfigState.BallTrailColor or Color3.fromRGB(43, 255, 172)
                local style = ConfigState.BallTrailStyle or "Solid"
                if style == "Rainbow" then
                    local h1 = (now * 0.55) % 1
                    local h2 = (h1 + 0.33) % 1
                    local h3 = (h1 + 0.66) % 1
                    tr.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromHSV(h1, 0.88, 1)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(h2, 0.88, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromHSV(h3, 0.88, 1)),
                    })
                elseif style == "Pulse" then
                    local pulse = 0.5 + 0.5 * math.sin(now * 6.0)
                    local c2 = baseCol:Lerp(Color3.fromRGB(255, 255, 255), pulse * 0.7)
                    tr.Color = ColorSequence.new(c2, baseCol)
                elseif style == "Fade" then
                    local dark = Color3.new(baseCol.R * 0.25, baseCol.G * 0.25, baseCol.B * 0.25)
                    tr.Color = ColorSequence.new(baseCol, dark)
                else
                    tr.Color = ColorSequence.new(baseCol)
                end
            else
                if RS.ballTrail then RS.ballTrail.Enabled = false end
            end

            -- Neon Ball Glow
            if ConfigState.NeonBallGlow then
                local gCol = ConfigState.NeonBallGlowColor or Color3.fromRGB(43, 255, 172)
                if not (RS.ballGlowLight and RS.ballGlowLight.Parent == ball) then
                    if RS.ballGlowLight then pcall(function() RS.ballGlowLight:Destroy() end) end
                    local pl = Instance.new("PointLight")
                    pl.Name = "CoreXYZ_BallGlowLight"
                    pl.Brightness = 3.2
                    pl.Range = 16
                    pl.Shadows = false
                    pl.Parent = ball
                    RS.ballGlowLight = pl
                end
                RS.ballGlowLight.Color = gCol
                RS.ballGlowLight.Enabled = true

                if not ConfigState.BallEsp then
                    if not (RS.ballGlowHighlight and RS.ballGlowHighlight.Parent) then
                        local hl = Instance.new("Highlight")
                        hl.Name = "CoreXYZ_BallNeonHL"
                        hl.DepthMode = Enum.HighlightDepthMode.Occluded
                        hl.FillTransparency = 0.2
                        hl.OutlineTransparency = 0.0
                        hl.Parent = UI.HighlightContainer or UI.ScreenGui
                        RS.ballGlowHighlight = hl
                    end
                    RS.ballGlowHighlight.Adornee = ball
                    RS.ballGlowHighlight.FillColor = gCol
                    RS.ballGlowHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    RS.ballGlowHighlight.Enabled = true
                elseif RS.ballGlowHighlight then
                    RS.ballGlowHighlight.Enabled = false
                end
            else
                if RS.ballGlowLight then RS.ballGlowLight.Enabled = false end
                if RS.ballGlowHighlight then RS.ballGlowHighlight.Enabled = false end
            end
        else
            if RS.ballHighlight then RS.ballHighlight.Enabled = false end
            if RS.ballBillboard then RS.ballBillboard.Enabled = false end
            if RS.ballTrail then RS.ballTrail.Enabled = false end
            if RS.ballGlowLight then RS.ballGlowLight.Enabled = false end
            if RS.ballGlowHighlight then RS.ballGlowHighlight.Enabled = false end
        end

        -- 2. Player ESP & 2D Box (Inverts color when player possesses ball!)
        local possessorId = (ball and tonumber(ball:GetAttribute("Possessor"))) or 0
        local activeModels = {}

        if ConfigState.PlayerEsp or ConfigState.Player2DBox then
            for _, child in ipairs(workspace:GetChildren()) do
                if child:IsA("Model") and child ~= myChar and (child:GetAttribute("DribbleId") ~= nil or child:GetAttribute("Team") ~= nil) then
                    local root = child:FindFirstChild("Root") or child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
                    if root and root:IsA("BasePart") then
                        activeModels[child] = true
                        local entry = RS.playerEspPool[child]
                        if not entry then
                            local hl = nil
                            pcall(function()
                                hl = Instance.new("Highlight")
                                hl.Name = "CoreXYZ_MannequinHL"
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.FillTransparency = 0.55
                                hl.OutlineTransparency = 0.05
                                hl.Parent = UI.HighlightContainer or UI.ScreenGui
                            end)
                            local boxLines = {}
                            for i = 1, 4 do
                                local l = Instance.new("Frame")
                                l.AnchorPoint = Vector2.new(0.5, 0.5)
                                l.BorderSizePixel = 0
                                l.Visible = false
                                l.ZIndex = 5
                                l.Parent = UI.OverlayContainer
                                boxLines[i] = l
                            end
                            local nameLbl = Instance.new("TextLabel")
                            nameLbl.AnchorPoint = Vector2.new(0.5, 1)
                            nameLbl.Size = UDim2.fromOffset(180, 15)
                            nameLbl.BackgroundTransparency = 1
                            nameLbl.Font = Enum.Font.Code
                            nameLbl.TextStrokeTransparency = 0.2
                            nameLbl.TextSize = 11
                            nameLbl.Visible = false
                            nameLbl.ZIndex = 6
                            nameLbl.Parent = UI.OverlayContainer
                            entry = { Highlight = hl, BoxLines = boxLines, NameLabel = nameLbl }
                            RS.playerEspPool[child] = entry
                        end

                        local charDribbleId = tonumber(child:GetAttribute("DribbleId")) or -888
                        local hasPossession = (possessorId ~= 0 and charDribbleId == possessorId)
                        local baseCol = ConfigState.PlayerEspColor or Color3.fromRGB(80, 185, 255)
                        local drawCol = hasPossession and Color3.new(1 - baseCol.R, 1 - baseCol.G, 1 - baseCol.B) or baseCol

                        local drawnTarget = getDrawnModel(child) or child
                        if entry.Highlight then
                            entry.Highlight.Adornee = drawnTarget
                            entry.Highlight.FillColor = drawCol
                            entry.Highlight.OutlineColor = drawCol
                            entry.Highlight.Enabled = (ConfigState.PlayerEsp == true)
                        end

                        local sp, onScreen = camera:WorldToViewportPoint(root.Position)
                        if onScreen and sp.Z > 0 then
                            local h = math.clamp(3200 / math.max(sp.Z, 6), 18, 220)
                            local w = h * 0.58
                            if ConfigState.Player2DBox then
                                local tl = Vector2.new(sp.X - w * 0.5, sp.Y - h * 0.5)
                                local tr = Vector2.new(sp.X + w * 0.5, sp.Y - h * 0.5)
                                local br = Vector2.new(sp.X + w * 0.5, sp.Y + h * 0.5)
                                local bl = Vector2.new(sp.X - w * 0.5, sp.Y + h * 0.5)
                                drawLineFrame(entry.BoxLines[1], tl, tr, drawCol, 1.5)
                                drawLineFrame(entry.BoxLines[2], tr, br, drawCol, 1.5)
                                drawLineFrame(entry.BoxLines[3], br, bl, drawCol, 1.5)
                                drawLineFrame(entry.BoxLines[4], bl, tl, drawCol, 1.5)
                            else
                                for i = 1, 4 do entry.BoxLines[i].Visible = false end
                            end

                            if ConfigState.PlayerEsp then
                                entry.NameLabel.Position = UDim2.fromOffset(sp.X, sp.Y - h * 0.5 - 3)
                                entry.NameLabel.TextColor3 = drawCol
                                entry.NameLabel.Text = hasPossession and (tostring(child.Name) .. " [BALL]") or tostring(child.Name)
                                entry.NameLabel.Visible = true
                            else
                                entry.NameLabel.Visible = false
                            end
                        else
                            for i = 1, 4 do entry.BoxLines[i].Visible = false end
                            entry.NameLabel.Visible = false
                        end
                    end
                end
            end
        end

        for modelKey, entry in pairs(RS.playerEspPool) do
            if not activeModels[modelKey] or not modelKey.Parent then
                if entry.Highlight then pcall(function() entry.Highlight.Enabled = false end) end
                for i = 1, 4 do entry.BoxLines[i].Visible = false end
                entry.NameLabel.Visible = false
                if not modelKey.Parent then
                    if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
                    for i = 1, 4 do pcall(function() entry.BoxLines[i]:Destroy() end) end
                    pcall(function() entry.NameLabel:Destroy() end)
                    RS.playerEspPool[modelKey] = nil
                end
            end
        end

        -- 3. Goal Box ESP
        renderGoalBox(camera, RS.GoalEast.Lo, RS.GoalEast.Hi, RS.goalBoxLines.East, ConfigState.GoalBoxColor, ConfigState.GoalBoxEsp)
        renderGoalBox(camera, RS.GoalWest.Lo, RS.GoalWest.Hi, RS.goalBoxLines.West, ConfigState.GoalBoxColor, ConfigState.GoalBoxEsp)
    end

    State.runKnifeDuelsStepped = function(_, _, _, dt)
        State.stepRagdollSoccer(dt or 0.016)
    end
    State.runKnifeDuelsRenderPass = function(cam, dt)
        State.renderRagdollSoccer(cam, dt or 0.016)
    end

    RunService.Heartbeat:Connect(function(dt)
        State.stepRagdollSoccer(dt or 0.016)
    end)
    RunService.Stepped:Connect(function(_, dt)
        State.stepRagdollSoccer(dt or 0.016)
    end)
    RunService.RenderStepped:Connect(function(dt)
        State.renderRagdollSoccer(workspace.CurrentCamera, dt or 0.016)
    end)
end

