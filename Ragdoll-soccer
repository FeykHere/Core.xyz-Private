function MystrixHub.Functions.ApplyPowerCurveVel(vel, spin, family, isRedirected)
    local PC = getgenv().MystrixPowerCurve
    if not PC then return vel, spin end
    local maxAllowed, topBase = MystrixHub.Functions.GetFamilyMaxSpeed(family)
    if PC.PowerMultEnabled and typeof(vel) == "Vector3" then
        local pMult = math.clamp(tonumber(PC.PowerMult) or 1.35, 1.0, 2.5)
        if not isRedirected then
            local t = math.clamp((pMult - 1.0) / 1.5, 0, 1)
            local vx = vel.X * pMult
            local vz = vel.Z * pMult
            -- Compensate vertical loft so faster horizontal shots stay flat and don't overshoot the crossbar
            local vy = vel.Y * math.clamp(1.0 - t * 0.18, 0.78, 1.0)
            local boosted = Vector3.new(vx, vy, vz)
            local mag = boosted.Magnitude
            local minFloor = math.min(maxAllowed, topBase * (0.78 + 0.22 * t))
            if mag > maxAllowed and mag > 0.001 then
                boosted = boosted * (maxAllowed / mag)
            elseif mag > 1 and mag < minFloor then
                boosted = boosted * (minFloor / mag)
            end
            vel = boosted
        else
            local mag = vel.Magnitude
            if mag > maxAllowed and mag > 0.001 then
                vel = vel * (maxAllowed / mag)
            end
        end
    end
    if PC.CurveMultEnabled and typeof(spin) == "Vector3" and not isRedirected then
        local cMult = math.clamp(tonumber(PC.CurveMult) or 1.5, 1.0, 3.0)
        spin = spin * cMult
    end
    return vel, spin
end

function MystrixHub.Functions.SilentAimGoalCompute()
    local SA = getgenv().MystrixSilentAim
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("Root")
    local goals = {}
    for _, part in ipairs(Services.CollectionService:GetTagged("SoccerGoalFrame")) do
        if part:IsA("BasePart") and part:IsDescendantOf(workspace) then
            table.insert(goals, part)
        end
    end
    if #goals < 2 then return nil end
    table.sort(goals, function(a, b) return a.Position.X < b.Position.X end)
    local team = char and char:GetAttribute("Team")
    local hasTeam = team == "Blue" or team == "Red"
    local chosen
    if hasTeam and SA.KeeperRules then
        local ok, side, area = pcall(function()
            return SA.KeeperRules.ownSide(team), SA.KeeperRules.area(team)
        end)
        if ok and side and area then
            for _, part in ipairs(goals) do
                if (part.Position.X - area.centre.X) * -side > 0 then
                    chosen = part
                    break
                end
            end
        end
    end
    if not chosen and hasTeam then
        local blueSide = workspace:GetAttribute("BlueSide") == 1 and 1 or -1
        local out = team == "Blue" and -blueSide or blueSide
        chosen = out == -1 and goals[1] or goals[#goals]
    end
    if not chosen and root then
        local look = root.CFrame.LookVector
        local bestDot = -math.huge
        for _, part in ipairs(goals) do
            local d = (part.Position.X - root.Position.X) * look.X
            if d > bestDot then
                bestDot = d
                chosen = part
            end
        end
    end
    if not chosen then return nil end
    local b = chosen.Position.X < (goals[1].Position.X + goals[#goals].Position.X) / 2 and -1 or 1
    local q = chosen.Size.Y / 9.142857142857142
    local ground = chosen.Position.Y - chosen.Size.Y / 2
    return {
        x = chosen.Position.X - b * chosen.Size.X / 2 + b * 0.21428571428571425 * q,
        z = chosen.Position.Z,
        ground = ground,
        top = ground + 8.714285714285714 * q,
        half = 13.071428571428571 * q,
        out = b,
        team = hasTeam and team or nil,
        char = char,
    }
end

function MystrixHub.Functions.DeviceScale()
    local H = MystrixHub
    if H.DeviceScaleValue then return H.DeviceScaleValue end
    local override = getgenv().MystrixBudgetScale
    if type(override) == "number" and override > 0 then
        H.DeviceScaleValue = override
        return override
    end
    local best = math.huge
    for _ = 1, 3 do
        local t0 = os.clock()
        local v = Vector3.new(1, 2, 3)
        local acc = 0
        for i = 1, 20000 do
            v = Vector3.new(v.X * 0.999 + 0.01, v.Y + 0.002, v.Z * 1.001):Lerp(Vector3.new(i, 0, 1), 0.001)
            acc += v.Magnitude
        end
        best = math.min(best, os.clock() - t0)
    end
    local scale = math.clamp(best / 0.004, 1, 6)
    if scale < 1.4 then scale = 1 end
    H.DeviceScaleValue = scale
    return scale
end

function MystrixHub.Functions.Budget(seconds)
    return seconds * MystrixHub.Functions.DeviceScale()
end

function MystrixHub.Functions.HookFunction(tbl, key, build)
    local target = tbl[key]
    if type(target) ~= "function" then return false end
    local holder = { fn = target }
    local wrapper = build(function(...) return holder.fn(...) end)
    if hookfunction then
        local ok, old = pcall(hookfunction, target, wrapper)
        if ok then
            if type(old) == "function" then
                holder.fn = old
                return true
            end
            return false
        end
    end
    local function replace()
        tbl[key] = wrapper
    end
    if pcall(replace) and tbl[key] == wrapper then return true end
    if setreadonly then
        pcall(setreadonly, tbl, false)
        if pcall(replace) and tbl[key] == wrapper then return true end
    end
    return false
end

