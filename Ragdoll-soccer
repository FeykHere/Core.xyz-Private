            F.InstantRecover(body)
            return
        end
        if not AR.Tackle then return end
        if now - (AR.OwnAt or -math.huge) < 0.6 then return end
        F.InstantRecover(body)
    end)
    MystrixHub.ConnectionController.Insert({ Disconnect = function()
        MystrixHub.Functions.StopAntiRagdoll()
    end })
