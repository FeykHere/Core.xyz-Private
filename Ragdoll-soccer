            kbBtn.ZIndex = 17
            kbBtn.Parent = row

            keybindEntry = {
                Name = tostring(text),
                Button = kbBtn,
                KeyCode = nil,
                KeyName = nil,
                Toggle = function()
                    if setState then
                        setState(not state, true)
                    end
                end,
            }
            table.insert(State.registeredKeybinds, keybindEntry)

            kbBtn.MouseButton1Click:Connect(function()
                if not isPCDevice() then
