local function resolveCharacterHitpart(char, mode)
    if not char then
        return nil
    end
    local pick = mode or "Head"
    if pick == "Random" then
        local idx = math.floor((os.clock() * 3.7) % 2)
        pick = (idx == 0) and "Head" or "Torso"
    end
    if pick == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    end
end

local function computePredictedAimPosition(targetPart, originPos, usePrediction, predScalar)
    if not targetPart then
        return Vector3.zero
    end
    local basePos = targetPart.Position
    if not usePrediction then
        return basePos
    end
    local vel = Vector3.zero
    pcall(function()
        vel = targetPart.AssemblyLinearVelocity or targetPart.Velocity or Vector3.zero
    end)
    local dist = (basePos - originPos).Magnitude
    local knifeSpeed = 135
    local flightTime = math.clamp(dist / knifeSpeed, 0.01, 1.2)
    local factor = tonumber(predScalar) or 0.16
    local dropY = 0.5 * 28 * (flightTime * flightTime) * (factor * 2.5)
    return basePos + (vel * factor) + Vector3.new(0, dropY, 0)
end

local function getClosestTarget(camera)
    local closestNormal, bestNormalScore = nil, math.huge
    local closestPriority, bestPriorityScore = nil, math.huge
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local useWallCheck = ConfigState.AimbotWallCheck
    local targetMode = ConfigState.FovTargetMode or "Closest to Crosshair"
    local myChar = LocalPlayer and LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local originPos = (myHRP and myHRP.Position) or (camera.CFrame and camera.CFrame.Position) or Vector3.zero

    if useWallCheck then
        rayParams.FilterDescendantsInstances = getSafeRaycastExcludeList()
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and passesTeamCheck(player) then
            local tagData = State.espObjects[player]
            local humanoid = (tagData and tagData.CachedChar == player.Character and tagData.CachedHum)
                or player.Character:FindFirstChildOfClass("Humanoid")
            local checkPart = resolveCharacterHitpart(player.Character, ConfigState.AimbotHitpart or ConfigState.TargetPart)
            if isKnifeDuelsCharacterAlive(player.Character) and checkPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(checkPart.Position)
                local isFront = (not screenPos.Z) or (screenPos.Z > 0)
                if onScreen and isFront then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if screenDist <= ConfigState.FOVRadius then
                        local visiblePass = true
                        if useWallCheck then
                            local dir = checkPart.Position - camera.CFrame.Position
                            local ray = workspace:Raycast(camera.CFrame.Position, dir.Unit * 999, rayParams)
                            visiblePass = (ray and ray.Instance and ray.Instance:IsDescendantOf(player.Character)) and true or false
                        end
                        if visiblePass then
                            local score = screenDist
                            if targetMode == "Closest To User" or targetMode == "Closest to User" then
                                score = (checkPart.Position - originPos).Magnitude
                            elseif targetMode == "Lowest Health" or targetMode == "lowest Health" then
                                score = (tonumber(humanoid.Health) or 100) * 1000 + (screenDist * 0.01)
                            end
                            if State.prioritizedPlayers[player.Name] then
                                if score <= bestPriorityScore then
                                    bestPriorityScore = score
                                    closestPriority = checkPart
                                end
                            else
                                if score <= bestNormalScore then
                                    bestNormalScore = score
                                    closestNormal = checkPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closestPriority or closestNormal
end

-- Universal Hitbox Expander (Supports Team Check, Whitelist & Auto-Refresh on New/Respawned Players)
local function updateHitboxExpander()
    for part, orig in pairs(State.hitboxCache) do
        if not part or not part.Parent then
            State.hitboxCache[part] = nil
        end
    end
    local wantPartMode = ConfigState.HitboxPart or "Torso"
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local isAlive = isKnifeDuelsCharacterAlive(char)
            local headPart = char:FindFirstChild("Head")
            local torsoPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            local activePart = (wantPartMode == "Head") and headPart or torsoPart
            local inactivePart = (wantPartMode == "Head") and torsoPart or headPart
            if inactivePart and State.hitboxCache[inactivePart] then
                local orig = State.hitboxCache[inactivePart]
                pcall(function()
                    inactivePart.Size = orig.Size
                    inactivePart.Transparency = orig.Transparency
                    inactivePart.CanCollide = orig.CanCollide
                end)
                State.hitboxCache[inactivePart] = nil
            end
            if activePart then
                if ConfigState.HitboxExpander and isAlive and passesTeamCheck(p) then
                    if not State.hitboxCache[activePart] then
                        State.hitboxCache[activePart] = {
                            Size = activePart.Size,
                            Transparency = activePart.Transparency,
                            CanCollide = activePart.CanCollide,
                        }
                    end
                    local sz = ConfigState.HitboxSize or 10
                    pcall(function()
                        activePart.Size = Vector3.new(sz, sz, sz)
                        activePart.Transparency = ConfigState.HitboxTransparency or 0.7
                        activePart.CanCollide = false
                    end)
                elseif State.hitboxCache[activePart] then
                    local orig = State.hitboxCache[activePart]
                    pcall(function()
                        activePart.Size = orig.Size
                        activePart.Transparency = orig.Transparency
                        activePart.CanCollide = orig.CanCollide
                    end)
                    State.hitboxCache[activePart] = nil
                end
            end
        end
    end
end

local function restoreAllHitboxes()
    for hrp, orig in pairs(State.hitboxCache) do
        if hrp and hrp.Parent then
            pcall(function()
                hrp.Size = orig.Size
                hrp.Transparency = orig.Transparency
                hrp.CanCollide = orig.CanCollide
            end)
        end
    end
    table.clear(State.hitboxCache)
end

-- X-Ray Vision (Map Wall Transparency with Full Restoration)
local function applyXRayVision(enabled)
    if enabled then
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("BasePart")
                and not string.find(desc.Name or "", "^CoreXyz_") then
                local isPlayerPart = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and desc:IsDescendantOf(p.Character) then
                        isPlayerPart = true
                        break
                    end
                end
                if not isPlayerPart and desc.Transparency < 0.95 then
                    if State.xrayCache[desc] == nil then
                        State.xrayCache[desc] = desc.Transparency
                    end
                    desc.Transparency = ConfigState.XRayTransparency
                end
            end
        end
    else
        for part, origT in pairs(State.xrayCache) do
            if part and part.Parent then
                pcall(function()
                    part.Transparency = origT
                end)
            end
        end
        table.clear(State.xrayCache)
    end
end

