local function getTargetPartFromCharacter(char, partName)
    if not char then
        return nil
    end
    local found = char:FindFirstChild(partName)
    if found then
        return found
    end
    if partName == "UpperTorso" or partName == "LowerTorso" then
        return char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif partName == "RightUpperArm" then
        return char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart")
    elseif partName == "LeftUpperArm" then
        return char:FindFirstChild("Left Arm") or char:FindFirstChild("HumanoidRootPart")
    elseif partName == "RightUpperLeg" or partName == "RightLowerLeg" then
        return char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg") or char:FindFirstChild("HumanoidRootPart")
    elseif partName == "LeftUpperLeg" or partName == "LeftLowerLeg" then
        return char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("Left Leg") or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function isPlayerWhitelisted(player)
    if not ConfigState.UseWhitelist then
        return false
    end
    return State.whitelistedPlayers[player.Name] == true
end

local function getPlayerTeamName(player)
    if not player then
        return nil
    end
    -- Check Knife Duels Player & Character Attributes (@Team, @TeamId, @DuelTeam)
    local okAttr, attrTeam = pcall(function()
        local t = player:GetAttribute("Team") or player:GetAttribute("TeamId") or player:GetAttribute("DuelTeam")
        if (not t or t == "") and player.Character then
            t = player.Character:GetAttribute("Team") or player.Character:GetAttribute("TeamId")
        end
        return t
    end)
    if okAttr and type(attrTeam) == "string" and attrTeam ~= "" and attrTeam ~= "None" and attrTeam ~= "FFA" and attrTeam ~= "Lobby" then
        return attrTeam
    end
    local t = player.Team
    if not t then
        return nil
    end
    if type(t) == "string" then
        return (t ~= "" and t ~= "None" and t ~= "FFA" and t ~= "Lobby") and t or nil
    end
    local ok, name = pcall(function()
        return t.Name
    end)
    if ok and type(name) == "string" and name ~= "" and name ~= "None" and name ~= "FFA" and name ~= "Lobby" then
        return name
    end
    local str = tostring(t)
    return (str ~= "" and str ~= "nil" and str ~= "None" and str ~= "FFA" and str ~= "Lobby") and str or nil
end

local function isKnifeDuelsCharacterAlive(char)
    if not char or not char.Parent then
        return false
    end
    if char:GetAttribute("DuelEliminated") == true or char:GetAttribute("DuelCharacterInvisible") == true or char:GetAttribute("Dead") == true or char:GetAttribute("Alive") == false then
        return false
    end
    local attrHP = tonumber(char:GetAttribute("HP"))
    if attrHP ~= nil and attrHP <= 0 then
        return false
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        return false
    end
    return true
end

local function passesTeamCheckWithFlag(player, checkTeamEnabled)
    if not player or player == LocalPlayer then
        return false
    end
    if isPlayerWhitelisted(player) then
        return false
    end
    if player.Character and not isKnifeDuelsCharacterAlive(player.Character) then
        return false
    end
    if not checkTeamEnabled then
        return true
    end
    local myTeam = getPlayerTeamName(LocalPlayer)
    local plrTeam = getPlayerTeamName(player)
    if myTeam and plrTeam and myTeam == plrTeam then
        return false
    end
    return true
end

local function passesTeamCheck(player)
    return passesTeamCheckWithFlag(player, ConfigState.TeamCheck)
end

local function syncWhitelistArrayFromMap()
    table.clear(State.whitelistArray)
    for name, active in pairs(State.whitelistedPlayers) do
        if active then
            table.insert(State.whitelistArray, name)
        end
    end
    table.sort(State.whitelistArray)
    if State.refreshWhitelistDropdown then
        local names = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(names, p.Name)
            end
        end
        State.refreshWhitelistDropdown(names, State.whitelistArray)
    end
end

