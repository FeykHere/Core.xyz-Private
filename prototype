local function UpdateVisuals()
    if State.Enabled then
        ToggleBtn.Text = "Shot Strength: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 135, 85)
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToggleStroke.Color = Color3.fromRGB(70, 200, 125)
    else
        ToggleBtn.Text = "Shot Strength: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(26, 30, 42)
        ToggleBtn.TextColor3 = Color3.fromRGB(200, 205, 220)
        ToggleStroke.Color = Color3.fromRGB(50, 58, 78)
    end

    local alpha = (State.Percent - 100) / 400
    SliderFill.Size = UDim2.new(math.clamp(alpha, 0, 1), 0, 1, 0)
    SliderLabel.Text = string.format("Strength: %d%% (%.2fx)", State.Percent, State.Multiplier)
end

ToggleBtn.MouseButton1Click:Connect(function()
    State.Enabled = not State.Enabled
    UpdateVisuals()
end)

local DraggingSlider = false

local function SetSliderFromX(screenX)
    local rel = math.clamp((screenX - SliderTrack.AbsolutePosition.X) / math.max(SliderTrack.AbsoluteSize.X, 1), 0, 1)
    local pct = math.floor(100 + rel * 400 + 0.5)
    State.Percent = math.clamp(pct, 100, 500)
    State.Multiplier = State.Percent / 100
    UpdateVisuals()
end

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = true
        SetSliderFromX(input.Position.X)
    end
end)

local DraggingWindow = false
local DragStart, StartPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingWindow = true
        DragStart = input.Position
        StartPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if DraggingSlider then
            SetSliderFromX(input.Position.X)
        elseif DraggingWindow and DragStart and StartPos then
            local delta = input.Position - DragStart
            MainFrame.Position = UDim2.new(
                StartPos.X.Scale,
                StartPos.X.Offset + delta.X,
                StartPos.Y.Scale,
                StartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = false
        DraggingWindow = false
    end
end)

UpdateVisuals()
