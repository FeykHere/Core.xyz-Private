-- // 2. Server-Synced Movement Helper
-- Drives character movement BEFORE CharacterReplicationClient.PostSimulation sends MovementUpdate,
-- and populates CharacterControllers.SetMoveCommand + CharacterMotion.SetStreamVelocity + AssemblyLinearVelocity
-- so CharacterReplicationClient transmits our real movement packets to the server for ball pickup & goal scoring.
local ActiveFarmingMove = false

local function StopCharacterDrive(char)
    if not ActiveFarmingMove then return end
    ActiveFarmingMove = false
    pcall(function()
        if PlayerMovement and type(PlayerMovement.ClearMultiplier) == "function" then
            PlayerMovement.ClearMultiplier("ItemMotion")
        end
        if char then
            if CharacterControllers and type(CharacterControllers.SetMoveCommand) == "function" then
                CharacterControllers.SetMoveCommand(char, Vector3.zero)
            end
            if CharacterMotion and type(CharacterMotion.SetStreamVelocity) == "function" then
                CharacterMotion.SetStreamVelocity(char, nil)
            end
        end
    end)
end

local function DriveCharacterTowards(char, hrp, hum, targetPos, lookTarget, dt)
    if not (char and hrp and hum and targetPos) then return false end
    ActiveFarmingMove = true

    -- Grant infinite stamina while farming
    if SprintAction and type(SprintAction.SetUnlimitedStamina) == "function" then
        pcall(SprintAction.SetUnlimitedStamina, LocalPlayer, "CoreAutoFarm", true)
    end
    pcall(function()
        char:SetAttribute("SprintIsSprinting", true)
    end)

    local curPos = hrp.Position
    local flatDelta = Vector3.new(targetPos.X - curPos.X, 0, targetPos.Z - curPos.Z)
    local flatDist = flatDelta.Magnitude

    local moveDir = flatDist > 0.05 and flatDelta.Unit or Vector3.zero
    local lookDir = moveDir
    if lookTarget then
        local lDelta = Vector3.new(lookTarget.X - curPos.X, 0, lookTarget.Z - curPos.Z)
        if lDelta.Magnitude > 0.05 then
            lookDir = lDelta.Unit
        end
    end
    if lookDir.Magnitude < 0.05 then
        local curLook = hrp.CFrame.LookVector
        local flatLook = Vector3.new(curLook.X, 0, curLook.Z)
        lookDir = flatLook.Magnitude > 0.05 and flatLook.Unit or Vector3.new(0, 0, -1)
    end

    local speed = State.MoveSpeed
    -- If server recently rubberbanded us because speed was set too high, clamp to safe server speed (40) briefly
    if os.clock() < State.CorrectionHoldUntil then
        speed = math.min(speed, 40)
    end

    local horizVel = moveDir * speed
    local curVelY = hrp.AssemblyLinearVelocity.Y
    local fullVel = Vector3.new(horizVel.X, curVelY, horizVel.Z)

    -- 1. Feed game's native Movement & ControllerManager
    pcall(function()
        if PlayerMovement and type(PlayerMovement.SetMultiplier) == "function" then
            local baseSpeed = (type(PlayerMovement.GetBaseWalkSpeed) == "function" and PlayerMovement.GetBaseWalkSpeed()) or 16
            PlayerMovement.SetMultiplier("ItemMotion", {
                WalkSpeed = math.max(speed / math.max(baseSpeed, 1), 1)
            })
        end
        if CharacterControllers then
            if type(CharacterControllers.SetWalkSpeed) == "function" then
                CharacterControllers.SetWalkSpeed(char, hum, speed)
            end
            if type(CharacterControllers.SetMoveCommand) == "function" then
                CharacterControllers.SetMoveCommand(char, moveDir, lookDir, true)
            end
        end
        local cm = char:FindFirstChildOfClass("ControllerManager")
        if cm then
            cm.BaseMoveSpeed = speed
            cm.MovingDirection = moveDir
            if lookDir.Magnitude > 0 then
                cm.FacingDirection = lookDir
            end
        end
    end)

    -- 2. Advance CFrame smoothly & set non-zero AssemblyLinearVelocity + StreamVelocity
    -- so watchOwnSimulation & sendLocalMovement transmit every packet to the server
    local stepDist = math.min(flatDist, speed * math.clamp(dt, 1 / 240, 0.05))
    local nextXZ = Vector3.new(curPos.X, 0, curPos.Z) + moveDir * stepDist
    local nextPos = Vector3.new(nextXZ.X, curPos.Y, nextXZ.Z)
    local nextCF = CFrame.lookAt(nextPos, nextPos + lookDir)

    hrp.CFrame = nextCF
    hrp.AssemblyLinearVelocity = fullVel
    hrp.AssemblyAngularVelocity = Vector3.zero

    pcall(function()
        if CharacterMotion and type(CharacterMotion.SetStreamVelocity) == "function" then
            CharacterMotion.SetStreamVelocity(char, fullVel)
        end
        if CharacterPlacement and type(CharacterPlacement.RecordPositionWrite) == "function" then
            CharacterPlacement.RecordPositionWrite(hrp, horizVel, curVelY)
        end
        if LocalMovementGuardMod then
            if type(LocalMovementGuardMod.RegisterVelocity) == "function" then
                LocalMovementGuardMod.RegisterVelocity(hrp, horizVel, curVelY)
            end
            if type(LocalMovementGuardMod.CapturePhysics) == "function" then
                LocalMovementGuardMod.CapturePhysics(hrp, hum)
            end
        end
    end)

    return flatDist <= 3.5
end

-- // Listen for Server MovementCorrection (detects if server anti-cheat rejected speed)
if MovementCorrectionRemote and MovementCorrectionRemote:IsA("RemoteEvent") then
    local corrConn = MovementCorrectionRemote.OnClientEvent:Connect(function(char, serverCF)
        if State.Enabled and char == LocalPlayer.Character and typeof(serverCF) == "CFrame" then
            State.CorrectionHoldUntil = os.clock() + 0.65
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = hrp.CFrame.Rotation + serverCF.Position
                if CharacterPlacement and type(CharacterPlacement.RecordPositionWrite) == "function" then
                    pcall(CharacterPlacement.RecordPositionWrite, hrp, Vector3.zero, 0)
                end
            end
        end
    end)
    table.insert(State.Connections, corrConn)
end

-- // 3. Find Enemy Goal Part & Best Open Goal Target
local function GetEnemyGoalPart()
    if TutorialSession and type(TutorialSession.GetGoalPart) == "function" then
        local ok, g = pcall(TutorialSession.GetGoalPart)
        if ok and g then return g end
    end
    if PracticeSession and type(PracticeSession.GetGoalParts) == "function" then
        local ok, parts = pcall(PracticeSession.GetGoalParts)
        if ok and type(parts) == "table" and parts[1] then return parts[1] end
    end

    local myTeam = nil
    if ActorTeams and type(ActorTeams.GetActorTeamName) == "function" then
        local ok, t = pcall(ActorTeams.GetActorTeamName, LocalPlayer)
        if ok then myTeam = t end
    end
    if not myTeam and LocalPlayer.Team then
        myTeam = LocalPlayer.Team.Name
    end

    local map = workspace:FindFirstChild("Map")
    local data = map and map:FindFirstChild("Data")
    if data then
        if myTeam and MatchSettings and type(MatchSettings.GetOpposingTeamName) == "function" then
            local ok, oppTeam = pcall(MatchSettings.GetOpposingTeamName, myTeam)
            if ok and oppTeam and data:FindFirstChild(oppTeam) then
                local g = data[oppTeam]:FindFirstChild("Goal")
                if g then return g end
            end
        end
        for _, folder in ipairs(data:GetChildren()) do
            if folder.Name ~= myTeam and folder:FindFirstChild("Goal") then
                return folder.Goal
            end
        end
    end
    return nil
end

local function GetBestGoalTarget(goalPart, fromPos)
    if not goalPart then return nil, nil end
    local center = goalPart.Position

    if ShotAimAssist and type(ShotAimAssist.GetGoalMouth) == "function" then
        local ok, mouth = pcall(ShotAimAssist.GetGoalMouth, goalPart, fromPos or center)
        if ok and type(mouth) == "table" and mouth.PlanePosition and mouth.Forward and mouth.Lateral then
            local halfW = math.max((mouth.HalfWidth or 10) - 3.5, 2)
            local leftSpot = mouth.PlanePosition + mouth.Lateral * (-halfW * 0.65)
            local rightSpot = mouth.PlanePosition + mouth.Lateral * (halfW * 0.65)

            local bestSide = mouth.PlanePosition
            local bestMinDist = -1
            for _, candidate in ipairs({ leftSpot, rightSpot, mouth.PlanePosition }) do
                local nearestEnemy = 999
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local eHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if eHrp then
                            local d = (eHrp.Position - candidate).Magnitude
                            if d < nearestEnemy then
                                nearestEnemy = d
                            end
                        end
                    end
                end
                if nearestEnemy > bestMinDist then
                    bestMinDist = nearestEnemy
                    bestSide = candidate
                end
            end

            local standPos = Vector3.new(bestSide.X, (fromPos and fromPos.Y) or bestSide.Y, bestSide.Z) - mouth.Forward * 1.5
            local shootAimPos = standPos - mouth.Forward * 6
            return standPos, shootAimPos
        end
    end

    local dirToGoal = (center - (fromPos or center))
    if dirToGoal.Magnitude > 1e-3 then
        dirToGoal = Vector3.new(dirToGoal.X, 0, dirToGoal.Z).Unit
    else
        dirToGoal = Vector3.new(0, 0, -1)
    end
    local standPos = Vector3.new(center.X, (fromPos and fromPos.Y) or center.Y, center.Z)
    local shootAimPos = standPos + dirToGoal * 6
    return standPos, shootAimPos
end

-- // 4. Check Live Ball State & Nearby Players
local function GetBallInfo()
    if BallRenderer then
        local isHidden = false
        if type(BallRenderer.IsMainMatchHidden) == "function" then
            local ok, h = pcall(BallRenderer.IsMainMatchHidden)
            if ok and h then isHidden = true end
        end
        if isHidden then return nil, nil, nil end

        local pos = nil
        if type(BallRenderer.GetMainMatchPosition) == "function" then
            local ok, p = pcall(BallRenderer.GetMainMatchPosition)
            if ok and typeof(p) == "Vector3" then pos = p end
        end
        if not pos and type(BallRenderer.GetPosition) == "function" then
            local ok, p = pcall(BallRenderer.GetPosition)
            if ok and typeof(p) == "Vector3" then pos = p end
        end

        local ownerId = nil
        if type(BallRenderer.GetMainMatchOwnerUserId) == "function" then
            local ok, o = pcall(BallRenderer.GetMainMatchOwnerUserId)
            if ok then ownerId = o end
        end
        if ownerId == nil and type(BallRenderer.GetOwnedUserId) == "function" then
            local ok, o = pcall(BallRenderer.GetOwnedUserId)
            if ok then ownerId = o end
        end

        local vel = Vector3.zero
        if type(BallRenderer.GetTargetVelocity) == "function" then
            local ok, v = pcall(BallRenderer.GetTargetVelocity)
            if ok and typeof(v) == "Vector3" then vel = v end
        end

        if pos then
            return pos, ownerId, vel
        end
    end

    local visuals = workspace:FindFirstChild("Visuals")
    local clientBall = visuals and (visuals:FindFirstChild("ClientBall_MainMatch") or visuals:FindFirstChild("ClientBall_1"))
    if clientBall and clientBall:IsA("BasePart") and clientBall.Transparency < 1 then
        return clientBall.Position, nil, Vector3.zero
    end
    return nil, nil, nil
end

local function IsAnyoneCloseToBall(ballPos, radius)
    if radius <= 0 then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local eHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local eHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if eHrp and eHum and eHum.Health > 0 then
                local dist = (Vector3.new(eHrp.Position.X, ballPos.Y, eHrp.Position.Z) - ballPos).Magnitude
                if dist <= radius then
                    return true, plr.Name, dist
                end
            end
        end
    end
    return false
end

-- // 5. Point-Blank Goal Finish
local LastAutoShotAt = 0
local SessionCounter = math.floor(GetServerTimeNow(workspace) * 1000) * 2

local function FirePointBlankGoalShot(hrp, aimTargetPos)
    local nowClock = os.clock()
    if nowClock - LastAutoShotAt < 0.28 then return end
    LastAutoShotAt = nowClock

    local origin = hrp.Position
    local dir = (aimTargetPos - origin)
    if dir.Magnitude < 1e-3 then
        dir = hrp.CFrame.LookVector
    else
        dir = dir.Unit
    end
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude < 1e-3 then
        flatDir = Vector3.new(0, 0, -1)
    else
        flatDir = flatDir.Unit
    end

    local aimTable = {
        Direction = dir,
        Origin = origin,
        CameraCFrame = CFrame.lookAt(origin, origin + dir),
        IsAirborne = false
    }

    local serverNow = GetServerTimeNow(workspace)
    local maxCharge = 0.4

    if ActionRemoteProtocol and type(ActionRemoteProtocol.Start) == "function" and type(ActionRemoteProtocol.Release) == "function" then
        pcall(function()
            ActionRemoteProtocol.Start({
                Kind = "Kick",
                PassType = "Shot",
                MaximumChargeSeconds = maxCharge,
                AimDirection = aimTable,
                KickDirection = flatDir,
                ShotTime = serverNow - maxCharge
            })
            ActionRemoteProtocol.Release({
                Kind = "Kick",
                PassType = "Shot",
                MaximumChargeSeconds = maxCharge,
                ChargeSeconds = maxCharge,
                ChargeStartedAt = serverNow - maxCharge,
                AimLockedAt = serverNow - 0.05,
                ShotTime = serverNow,
                AimDirection = aimTable,
                KickDirection = flatDir
            })
        end)
    elseif KickRemote then
        SessionCounter = SessionCounter + 2
        local sid = SessionCounter
        pcall(function()
            KickRemote:FireServer({
                Protocol = "ActionSession",
                Phase = "Start",
                Command = {
                    MaximumChargeSeconds = maxCharge,
                    AimDirection = aimTable,
                    SessionId = sid,
                    ShotTime = serverNow - maxCharge,
                    PassType = "Shot",
                    PlayerVelocity = flatDir * 36,
                    Kind = "Kick",
                    KickDirection = flatDir
                }
            })
            KickRemote:FireServer({
                Protocol = "ActionSession",
                Phase = "Release",
                Command = {
                    MaximumChargeSeconds = maxCharge,
                    AimDirection = aimTable,
                    ChargeStartedAt = serverNow - maxCharge,
                    SessionId = sid,
                    ShotTime = serverNow,
                    ChargeSeconds = maxCharge,
                    PassType = "Shot",
                    AimLockedAt = serverNow - 0.05,
                    PlayerVelocity = flatDir * 36,
                    Kind = "Kick",
                    KickDirection = flatDir
                }
            })
        end)
    end
end

