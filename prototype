StatusLabel.Font = Enum.Font.Gotham
StatusLabel.TextSize = 11
StatusLabel.TextXAlignment = Enum.TextXAlignment.Left
StatusLabel.Parent = MainFrame

local function SetStatus(txt)
    if State.Status ~= txt then
        State.Status = txt
        pcall(function()
            StatusLabel.Text = "Status: " .. txt
        end)
    end
end

local function UpdateVisuals()
    pcall(function()
        if State.Enabled then
            ToggleBtn.Text = "Auto Farm Goals: ON"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 135, 85)
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleStroke.Color = Color3.fromRGB(70, 200, 125)
        else
            ToggleBtn.Text = "Auto Farm Goals: OFF"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(26, 30, 42)
            ToggleBtn.TextColor3 = Color3.fromRGB(200, 205, 220)
            ToggleStroke.Color = Color3.fromRGB(50, 58, 78)
            SetStatus("Idle")
        end

        local speedAlpha = math.clamp((State.MoveSpeed - 25) / (150 - 25), 0, 1)
        SpeedFill.Size = UDim2.new(speedAlpha, 0, 1, 0)
        local tag = State.MoveSpeed <= 48 and "(Server Safe)" or "(Fast - May Rubberband)"
        SpeedLabel.Text = string.format("Move Speed: %d studs/s %s", State.MoveSpeed, tag)

        local alpha = math.clamp(State.SafeRadius / 40, 0, 1)
        SliderFill.Size = UDim2.new(alpha, 0, 1, 0)
        SliderLabel.Text = string.format("Safe Ball Distance: %d studs", State.SafeRadius)
    end)
end

ToggleBtn.MouseButton1Click:Connect(function()
    State.Enabled = not State.Enabled
    if not State.Enabled then
        StopCharacterDrive(LocalPlayer.Character)
    end
    UpdateVisuals()
end)

local DraggingSpeed = false
local DraggingRadius = false
local DraggingWindow = false
local DragStart, StartPos

local function SetSpeedFromX(screenX)
    local rel = math.clamp((screenX - SpeedTrack.AbsolutePosition.X) / math.max(SpeedTrack.AbsoluteSize.X, 1), 0, 1)
    State.MoveSpeed = math.clamp(math.floor(25 + rel * (150 - 25) + 0.5), 25, 150)
    UpdateVisuals()
end

local function SetRadiusFromX(screenX)
    local rel = math.clamp((screenX - SliderTrack.AbsolutePosition.X) / math.max(SliderTrack.AbsoluteSize.X, 1), 0, 1)
    State.SafeRadius = math.clamp(math.floor(rel * 40 + 0.5), 0, 40)
    UpdateVisuals()
end

SpeedTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSpeed = true
        SetSpeedFromX(input.Position.X)
    end
end)

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingRadius = true
        SetRadiusFromX(input.Position.X)
    end
end)

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingWindow = true
        DragStart = input.Position
        StartPos = MainFrame.Position
    end
end)

table.insert(State.Connections, UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if DraggingSpeed then
            SetSpeedFromX(input.Position.X)
        elseif DraggingRadius then
            SetRadiusFromX(input.Position.X)
        elseif DraggingWindow and DragStart and StartPos then
            local delta = input.Position - DragStart
            MainFrame.Position = UDim2.new(
                StartPos.X.Scale,
                StartPos.X.Offset + delta.X,
                StartPos.Y.Scale,
                StartPos.Y.Offset + delta.Y
            )
        end
    end
end))

table.insert(State.Connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSpeed = false
        DraggingRadius = false
        DraggingWindow = false
    end
end))

-- // 7. Main Auto-Farm PreSimulation Loop
-- Runs on PreSimulation so our velocity & MoveCommand are set right BEFORE CharacterReplicationClient.PostSimulation
-- sends Remotes.Characters.MovementUpdate to the server.
local simConn = RunService.PreSimulation:Connect(function(dt)
    if not State.Enabled then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and hrp and hum and hum.Health > 0) then
        SetStatus("Waiting for Character")
        return
    end

    if KickoffFreeze and type(KickoffFreeze.IsFrozen) == "function" then
        local ok, frozen = pcall(KickoffFreeze.IsFrozen)
        if ok and frozen then
            StopCharacterDrive(char)
            SetStatus("Waiting (Kickoff Freeze)")
            return
        end
    end
    if GoalReplay and type(GoalReplay.IsActive) == "function" then
        local ok, active = pcall(GoalReplay.IsActive)
        if ok and active then
            StopCharacterDrive(char)
            SetStatus("Waiting (Goal Replay)")
            return
        end
    end
    if Ragdoll and type(Ragdoll.IsEnabled) == "function" then
        local ok, rag = pcall(Ragdoll.IsEnabled, char)
        if ok and rag then
            StopCharacterDrive(char)
            SetStatus("Waiting (Ragdolled)")
            return
        end
    end

    local ballPos, ownerUserId, ballVel = GetBallInfo()
    if not ballPos then
        StopCharacterDrive(char)
        SetStatus("Waiting for Match Ball")
        return
    end

    local goalPart = GetEnemyGoalPart()
    if not goalPart then
        StopCharacterDrive(char)
        SetStatus("Waiting for Enemy Goal")
        return
    end

    -- CASE 1: We own the ball -> Drive to enemy goal post & score!
    if ownerUserId == LocalPlayer.UserId then
        local standPos, shootAimPos = GetBestGoalTarget(goalPart, hrp.Position)
        if standPos then
            SetStatus("Has Ball -> Driving to Enemy Goal!")
            local reached = DriveCharacterTowards(char, hrp, hum, standPos, shootAimPos, dt)
            local distToGoal = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(standPos.X, 0, standPos.Z)).Magnitude
            if reached or distToGoal <= 16 then
                FirePointBlankGoalShot(hrp, shootAimPos)
            end
        end
        return
    end

    -- CASE 2: Someone else owns the ball -> Wait safely
    if ownerUserId ~= nil and ownerUserId ~= LocalPlayer.UserId then
        StopCharacterDrive(char)
        SetStatus("Waiting (Ball Owned)")
        return
    end

    -- CASE 3: Ball is free -> Check if anyone is too close to the ball
    local tooClose, closestName = IsAnyoneCloseToBall(ballPos, State.SafeRadius)
    if tooClose then
        StopCharacterDrive(char)
        SetStatus("Waiting (" .. tostring(closestName) .. " near ball)")
        return
    end

    -- CASE 4: Ball is free & clear -> Drive through ball's server pickup hitbox
    local leadPos = ballPos
    if typeof(ballVel) == "Vector3" and ballVel.Magnitude > 1 then
        leadPos = ballPos + Vector3.new(ballVel.X, 0, ballVel.Z) * 0.08
    end

    local statusTxt = os.clock() < State.CorrectionHoldUntil
        and "Fetching Ball (Server Synced 40s/s)"
        or "Fetching Free Ball..."
    SetStatus(statusTxt)
    DriveCharacterTowards(char, hrp, hum, leadPos, goalPart.Position, dt)
end)
table.insert(State.Connections, simConn)

if getgenv then
    getgenv().__CoreIllegalSoccerAutoFarmCleanup = function()
        State.Enabled = false
        StopCharacterDrive(LocalPlayer.Character)
        for _, conn in ipairs(State.Connections) do
            pcall(function() conn:Disconnect() end)
        end
        pcall(function() ScreenGui:Destroy() end)
    end
end

UpdateVisuals()
