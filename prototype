-- // Backup Original Constants
local BaseConstants = {
    ShotMin = Shoot and Shoot.Constants and Shoot.Constants.Shot and Shoot.Constants.Shot.MinimumSpeed or 70,
    ShotMax = Shoot and Shoot.Constants and Shoot.Constants.Shot and Shoot.Constants.Shot.MaximumSpeed or 123,
    PassGroundMin = Pass and Pass.Constants and Pass.Constants.Ground and Pass.Constants.Ground.MinimumSpeed or 62,
    PassGroundMax = Pass and Pass.Constants and Pass.Constants.Ground and Pass.Constants.Ground.MaximumSpeed or 105,
    PassLobMin = Pass and Pass.Constants and Pass.Constants.Lob and Pass.Constants.Lob.MinimumSpeed or 52,
    PassLobMax = Pass and Pass.Constants and Pass.Constants.Lob and Pass.Constants.Lob.MaximumSpeed or 95,
    ThrowMin = Throw and Throw.Constants and Throw.Constants.MinimumSpeed or 62,
    ThrowMax = Throw and Throw.Constants and Throw.Constants.MaximumSpeed or 105,
    HeadbuttMin = Headbutt and Headbutt.Constants and Headbutt.Constants.MinimumSpeed or 40,
    HeadbuttMax = Headbutt and Headbutt.Constants and Headbutt.Constants.MaximumSpeed or 135,
}

local function IsLocalActor(actor)
    if not actor or not LocalPlayer then return true end
    if actor == LocalPlayer or actor == LocalPlayer.Character then return true end
    if typeof(actor) == "Instance" and LocalPlayer.Character and actor:IsDescendantOf(LocalPlayer.Character) then
        return true
    end
    return false
end

-- // Apply Shot Strength to Game Modules
local function ApplyShotStrength()
    local mult = State.Enabled and State.Multiplier or 1.0

    -- 1. Scale Shoot / Pass / Throw / Headbutt Constants
    if Shoot and Shoot.Constants and Shoot.Constants.Shot then
        Shoot.Constants.Shot.MinimumSpeed = BaseConstants.ShotMin * mult
        Shoot.Constants.Shot.MaximumSpeed = BaseConstants.ShotMax * mult
    end
    if Pass and Pass.Constants then
        if Pass.Constants.Ground then
            Pass.Constants.Ground.MinimumSpeed = BaseConstants.PassGroundMin * mult
            Pass.Constants.Ground.MaximumSpeed = BaseConstants.PassGroundMax * mult
        end
        if Pass.Constants.Lob then
            Pass.Constants.Lob.MinimumSpeed = BaseConstants.PassLobMin * mult
            Pass.Constants.Lob.MaximumSpeed = BaseConstants.PassLobMax * mult
        end
    end
    if Throw and Throw.Constants then
        Throw.Constants.MinimumSpeed = BaseConstants.ThrowMin * mult
        Throw.Constants.MaximumSpeed = BaseConstants.ThrowMax * mult
    end
    if Headbutt and Headbutt.Constants then
        Headbutt.Constants.MinimumSpeed = BaseConstants.HeadbuttMin * mult
        Headbutt.Constants.MaximumSpeed = BaseConstants.HeadbuttMax * mult
    end

    -- 2. Apply Launch Multipliers in KickCore
    if KickCore and type(KickCore.SetLaunchMultipliers) == "function" then
        pcall(function()
            if TuningScope and type(TuningScope.SetAffectedUserIds) == "function" then
                TuningScope.SetAffectedUserIds(nil)
            end
            KickCore.SetLaunchMultipliers({
                Kick = mult,
                Lob = mult,
                Pass = mult
            })
        end)
    end
end

-- // Hook KickCore & KickPowerups functions
if KickCore and type(KickCore.GetLaunchMultiplier) == "function" then
    local oldGetLaunchMultiplier = KickCore.GetLaunchMultiplier
    KickCore.GetLaunchMultiplier = function(kind, actor, ...)
        if State.Enabled and State.Multiplier > 1 and IsLocalActor(actor) then
            return State.Multiplier
        end
        return oldGetLaunchMultiplier(kind, actor, ...)
    end
end

if KickPowerups then
    if type(KickPowerups.GetMultiplier) == "function" then
        local oldGetMultiplier = KickPowerups.GetMultiplier
        KickPowerups.GetMultiplier = function(actor, ...)
            local base = oldGetMultiplier(actor, ...) or 1
            if State.Enabled and State.Multiplier > 1 and IsLocalActor(actor) then
                return math.max(base, State.Multiplier)
            end
            return base
        end
    end
    if type(KickPowerups.GetVelocityMultipliers) == "function" then
        local oldGetVelMult = KickPowerups.GetVelocityMultipliers
        KickPowerups.GetVelocityMultipliers = function(multArg, ...)
            if State.Enabled and State.Multiplier > 1 then
                local m = math.max(tonumber(multArg) or 1, State.Multiplier)
                return m, 1 + (m - 1) * 0.35
            end
            return oldGetVelMult(multArg, ...)
        end
    end
end

-- // Helper to boost ActionSession Command table before sending to server
local LastStartShotTime = nil

local function BoostKickCommand(phase, cmd)
    if type(cmd) ~= "table" then return end
    if not (State.Enabled and State.Multiplier > 1) then return end

    local maxCharge = tonumber(cmd.MaximumChargeSeconds) or 0.4
    local now = tonumber(cmd.ShotTime) or workspace:GetServerTimeNow()

    if phase == "Start" then
        LastStartShotTime = now - maxCharge
        cmd.ShotTime = LastStartShotTime
    elseif phase == "Release" then
        cmd.ChargeSeconds = maxCharge
        cmd.ChargeStartedAt = LastStartShotTime or (now - maxCharge)
        cmd.ShotTime = math.max(now, cmd.ChargeStartedAt + maxCharge)
    end

    local dir = cmd.KickDirection
    if typeof(dir) ~= "Vector3" and type(cmd.AimDirection) == "table" and typeof(cmd.AimDirection.Direction) == "Vector3" then
        local aimDir = cmd.AimDirection.Direction
        local flat = Vector3.new(aimDir.X, 0, aimDir.Z)
        if flat.Magnitude > 1e-4 then
            dir = flat.Unit
        end
    end
    if typeof(dir) == "Vector3" and dir.Magnitude > 1e-4 then
        local flatUnit = Vector3.new(dir.X, 0, dir.Z).Unit
        local alpha = math.clamp((State.Multiplier - 1) / 4, 0, 1)
        local boostSpeed = 24 + (28 * alpha) * State.Multiplier
        cmd.PlayerVelocity = flatUnit * boostSpeed
    end
end

-- // Hook ActionRemoteProtocol
if ActionRemoteProtocol then
    for _, methodName in ipairs({ "Start", "Update", "Release" }) do
        local oldFn = ActionRemoteProtocol[methodName]
        if type(oldFn) == "function" then
            ActionRemoteProtocol[methodName] = function(cmd, ...)
                if State.Enabled and State.Multiplier > 1 and type(cmd) == "table" then
                    BoostKickCommand(methodName, cmd)
                end
                return oldFn(cmd, ...)
            end
        end
    end
end

-- // Hook ReplicatedStorage.Remotes.Ball.Kick:FireServer (__namecall)
if hookmetamethod and getnamecallmethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if State.Enabled and State.Multiplier > 1 and self == KickRemote and (method == "FireServer" or method == "fireServer") then
            local args = { ... }
            local packet = args[1]
            if type(packet) == "table" and packet.Protocol == "ActionSession" and type(packet.Command) == "table" then
                BoostKickCommand(packet.Phase, packet.Command)
                return oldNamecall(self, unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)
end

