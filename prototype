-- // Core.xyz · Illegal Soccer Prototype (Fixed __namecall + Server-Synced Shot Boost)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
-- Cache dot-method so we NEVER use colon calls inside __namecall (which corrupts namecall method register!)
local GetServerTimeNow = workspace.GetServerTimeNow

-- // State
local State = {
    Enabled = false,
    Percent = 100, -- 100% to 500%
    Multiplier = 1.0
}

local function SafeRequire(inst)
    if not inst then return nil end
    local ok, mod = pcall(require, inst)
    return ok and mod or nil
end

local Modules = ReplicatedStorage:WaitForChild("Modules", 10)
local Actions = Modules and Modules:WaitForChild("Actions", 10)
local KickCore = Actions and SafeRequire(Actions:FindFirstChild("KickCore"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
local BallRemotes = Remotes and Remotes:WaitForChild("Ball", 10)
local KickRemote = BallRemotes and BallRemotes:WaitForChild("Kick", 10)
local ActionUpdateRemote = BallRemotes and BallRemotes:FindFirstChild("ActionUpdate")
local NativeFireServer = KickRemote and KickRemote.FireServer

local function IsLocalActor(actor)
    if not actor or not LocalPlayer then return true end
    if actor == LocalPlayer or actor == LocalPlayer.Character then return true end
    if typeof(actor) == "Instance" and LocalPlayer.Character and actor:IsDescendantOf(LocalPlayer.Character) then
        return true
    end
    return false
end

-- // Sync client GetKickerVelocity with boosted server PlayerVelocity so client prediction matches server (no fast-then-slow rubberband)
if KickCore and type(KickCore.GetKickerVelocity) == "function" then
    local oldGetKickerVelocity = KickCore.GetKickerVelocity
    KickCore.GetKickerVelocity = function(actor, reportedVel, ...)
        if State.Enabled and State.Multiplier > 1 and IsLocalActor(actor) then
            local char = LocalPlayer and LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local look = hrp.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude > 1e-4 then
                    local alpha = math.clamp((State.Multiplier - 1) / 4, 0, 1)
                    -- Server SanitizeReportedVelocity allows up to ~38.4 - 52 studs/s along KickDirection
                    return flat.Unit * (38.4 * alpha)
                end
            end
        end
        return oldGetKickerVelocity(actor, reportedVel, ...)
    end
end

-- // Boost ActionSession Command without ANY colon calls (safe inside __namecall)
local LastSessionStartTime = {}

local function BoostKickCommand(phase, cmd)
    if type(cmd) ~= "table" then return end
    if not (State.Enabled and State.Multiplier > 1) then return end

    local maxCharge = tonumber(cmd.MaximumChargeSeconds) or 0.4
    local now = tonumber(cmd.ShotTime) or GetServerTimeNow(workspace)
    local sid = cmd.SessionId

    if phase == "Start" then
        -- Backdate Start timestamp by maxCharge so even an instant tap passes server elapsed-time check for 100% power
        local backdated = now - maxCharge
        cmd.ShotTime = backdated
        if sid then
            LastSessionStartTime[sid] = backdated
        end
    elseif phase == "Release" then
        local startAt = (sid and LastSessionStartTime[sid]) or (tonumber(cmd.ChargeStartedAt) and (cmd.ChargeStartedAt - maxCharge)) or (now - maxCharge)
        cmd.ChargeStartedAt = startAt
        cmd.ChargeSeconds = maxCharge
        if tonumber(cmd.ShotTime) and cmd.ShotTime < startAt + maxCharge then
            cmd.ShotTime = startAt + maxCharge
        end
    end

    -- Inject forward PlayerVelocity along KickDirection (server adds 50% of SanitizeReportedVelocity via GetInheritedVelocity)
    local dir = cmd.KickDirection
    if typeof(dir) ~= "Vector3" then
        local aim = cmd.AimDirection
        if type(aim) == "table" and typeof(aim.Direction) == "Vector3" then
            local d = aim.Direction
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude > 1e-4 then
                dir = flat.Unit
            end
        end
    end

    if typeof(dir) == "Vector3" and dir.Magnitude > 1e-4 then
        local flatUnit = Vector3.new(dir.X, 0, dir.Z).Unit
        local alpha = math.clamp((State.Multiplier - 1) / 4, 0, 1)
        local boostSpeed = 20 + (32 * alpha) * State.Multiplier
        cmd.PlayerVelocity = flatUnit * boostSpeed
    end
end

-- // Safe __namecall hook (NO colon calls inside hook -> never corrupts getnamecallmethod!)
if hookmetamethod and getnamecallmethod and NativeFireServer then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if State.Enabled and State.Multiplier > 1 and (self == KickRemote or self == ActionUpdateRemote) and (method == "FireServer" or method == "fireServer") then
            local packet = ...
            if type(packet) == "table" and packet.Protocol == "ActionSession" and type(packet.Command) == "table" then
                BoostKickCommand(packet.Phase, packet.Command)
                return NativeFireServer(self, packet)
            end
        end
        return oldNamecall(self, ...)
    end)
end

